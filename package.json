{
  "name": "keskkonnaportaali-praktika",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "NODE_ENV=development node --watch server/index.mjs",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "start": "NODE_ENV=production node server/index.mjs",
    "sync:corpus": "node server/sync-corpus.mjs",
    "eval:live": "node scripts/evaluate-live-search.mjs",
    "eval:holdout": "node scripts/evaluate-relevance-holdout.mjs",
    "eval:blind": "node scripts/evaluate-relevance-holdout.mjs --dataset=environment_search_blind_spot_v1.json",
    "eval:open": "node scripts/evaluate-open-search.mjs",
    "eval:public": "node scripts/evaluate-public-search.mjs",
    "audit:grounding": "node scripts/audit-live-grounding.mjs",
    "audit:filters": "node scripts/audit-live-filters.mjs",
    "audit:followups": "node scripts/audit-live-followups.mjs",
    "audit:load": "node scripts/load-search.mjs",
    "audit:load-results": "node scripts/load-search.mjs --endpoint=results --server-concurrency=8",
    "test": "MULTILINGUAL_SEARCH_ENABLED=true node --test --test-concurrency=4 tests/*.test.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@openai/agents": "0.17.0",
    "cheerio": "^1.1.2",
    "express": "5.1.0",
    "ipaddr.js": "1.9.1",
    "jsonrepair": "^3.13.1",
    "openai": "7.5.0",
    "pg": "^8.16.3",
    "proxy-addr": "2.0.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.3"
  }
}
