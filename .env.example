# Rakenduse port konteineris
PORT=3000

# Terrapointi avaliku API alus-URL ainult vanade proxy-route'ide tagasiühilduvuseks.
# Üldotsing Terrapointi ei kasuta.
TERRAPOINT_API_URL=https://terrapoint.ee

# Kohalik otseühendus kasutab fikseeritud loopback-päritolu. Muuda porti koos PORT-iga.
# Proxy taga tootmises määra PROXY_MODE=trusted, täpne avalik HTTPS-päritolu ning
# paremalt vasakule usaldatav proxy-ahel. Brauserivärav ei usalda kunagi Host-päist.
PROXY_MODE=direct
PUBLIC_ORIGIN=http://127.0.0.1:3000
# Komaga eraldatud ainult tegeliku reverse-proxy ja lubatud edge-proxy CIDR-id.
TRUSTED_PROXY_CIDRS=
# IPv6 privacy-aadressid koondatakse kõigis abuse-control võtmetes vaikimisi
# samaks /64 kliendiks. Kui operaator jagab klientidele /56 või /48, määra see
# vastavalt; /128 on teadlik viis koondamine välja lülitada.
IPV6_CLIENT_PREFIX_BITS=64
# Kõik vastused on piiratud jõude- ja absoluutse elueaga. Protsessi socket'ite,
# üldiste vastuste ja ühe kliendi aktiivsete vastuste laed jätavad
# tervisekontrollidele eraldi reservi.
MAX_HTTP_CONNECTIONS=256
# Enne HTTP-päiste parsimist võib üks otseühenduv peer hoida kuni 32 socket'it;
# üldlagi 224 jätab loopback-readiness kontrollile 32 ühenduse reservi.
# Usaldatud ingress ei kasuta ühe peeri lage, kuid jääb üldlae sisse.
MAX_GENERAL_HTTP_SOCKETS=224
MAX_HTTP_SOCKETS_PER_PEER=32
MAX_ACTIVE_PUBLIC_RESPONSES=224
MAX_ACTIVE_GENERAL_RESPONSES=192
MAX_ACTIVE_PUBLIC_RESPONSES_PER_CLIENT=16
MAX_ACTIVE_GENERAL_RESPONSES_PER_CLIENT=12
PUBLIC_RESPONSE_IDLE_TIMEOUT_MS=20000
PUBLIC_RESPONSE_ABSOLUTE_TIMEOUT_MS=60000

# Eraldatud praktika andmebaas otsingu vahemälu ja päringute päritolu jaoks.
# Näidis on teadlikult mittekäivitatav: genereeri mõlemad saladused eraldi,
# näiteks kaks korda `openssl rand -base64 48`, enne Compose'i käivitamist.
POSTGRES_PASSWORD=
# Kohaliku `npm start` jaoks koosta URL enda eraldi parooliga; Compose moodustab selle ise.
DATABASE_URL=
# Režiim on iga seadistatud andmebaasi korral kohustuslik. "disable" sobib ainult
# täpselt Compose'i `postgres` hostile, loopback'ile või allpool eksplitsiitselt
# lubatud privaatsele Docker-võrgu hostile; muu host keeldub käivitumast.
# Võrguülese andmebaasi jaoks kasuta "verify-full"; privaatse CA PEM võib anda DATABASE_SSL_CA kaudu.
DATABASE_SSL_MODE=disable
# Komadega eraldatud täpsed hostinimed ilma skeemi, pordi ja wildcard'ita.
# Jäta lokaalses Compose'is tühjaks; Coolify runtime lubab ainult oma DB teenuse hosti.
DATABASE_PLAINTEXT_HOSTS=
DATABASE_SSL_CA=
DATABASE_POOL_MAX=12
DATABASE_QUERY_TIMEOUT_MS=4000
SEARCH_CACHE_ENABLED=true
# Anonymous persistence has independent hard cardinality ceilings. Values are
# clamped in the server (cache 100-10 000, runs 1 000-100 000); cleanup removes
# at most one bounded batch per transaction and skips optional writes while a
# previous replica owns the shared maintenance lock.
SEARCH_CACHE_MAX_ROWS=5000
SEARCH_RUN_MAX_ROWS=50000
SEARCH_RETENTION_BATCH_SIZE=250
# Vähemalt 32 juhuslikku baiti kanoonilises Base64/Base64URL vormis; genereeri
# näiteks `openssl rand -base64 48`; kasutatakse päringute võtmega HMAC-sõrmejäljeks.
# Peab olema andmebaasi paroolist sõltumatu; püsiva andmebaasi korral server muidu ei käivitu.
SEARCH_HASH_SECRET=
SEARCH_DEADLINE_MS=15000
SEARCH_MAX_CONCURRENCY=8
# Üks kliendiaadress saab vaikimisi kuni kaks aktiivset otsingut; väärtus ei saa
# tõusta globaalse piirini, sest osa mahust peab jääma teistele klientidele.
SEARCH_MAX_CONCURRENCY_PER_CLIENT=2

# Keskkonnaportaali 8400+ URL-i ja otsingukaartide kohalik corpus.
# Käivitamisel tehakse sünkroniseerimine ainult siis, kui viimane edukas jooks on vana.
CORPUS_SYNC_ON_START=true
CORPUS_SYNC_INTERVAL_HOURS=24
CORPUS_SEED_QUERIES=mets
CORPUS_STARTUP_HYDRATE_LIMIT=200
# Kättesaamatud portaali URL-id kustutatakse 30 päeva järel; kogu korpusel on
# lisaks andmebaasiülene rea- ja ligikaudne salvestusmahu lagi.
PORTAL_UNAVAILABLE_RETENTION_HOURS=720
CORPUS_MAX_ROWS=150000
CORPUS_MAX_BYTES=2000000000
# Päringuaegse ametliku avastuse kirjed peidetakse 7 päeva järel ja kustutatakse
# 14 päeva järel, kui sama URL-i enam ei leita (lubatud vahemik 24–720 tundi).
OFFICIAL_DISCOVERY_RETENTION_HOURS=168
# Säilitusakna jooksul võetakse vastu kuni 10 000 uut URL-i, ühe kliendi kohta
# kuni 500; andmebaasis on live-avastuse kirjetele sõltumatu 20 000 rea lagi.
OFFICIAL_DISCOVERY_MAX_ROWS=20000
OFFICIAL_DISCOVERY_PROCESS_URL_BUDGET=10000
OFFICIAL_DISCOVERY_CLIENT_URL_BUDGET=500

# Serveripoolne, ainult valitud tõenditele toetuv Luna sõnastuskiht.
# OpenCode Zen/Go pakub gpt-5.6-luna mudelit Responses API kaudu.
OPENCODE_ZEN_API_KEY=
OPENCODE_GO_API_KEY=
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=gpt-5.6-luna
LLM_FALLBACK_MODEL=
LLM_ENABLED=true
LLM_TIMEOUT_MS=14500
LLM_MAX_TOKENS=3200
LLM_REASONING_EFFORT=low
LLM_API_STYLE=responses
# Mitme nähtava allika korral kasutab manager Agents SDK relevantsus- ja tõendispetsialiste.
# Väärtus "direct" jätab alles ühe mudelikõne varutee.
LLM_ORCHESTRATION=agents
LLM_CIRCUIT_BREAK_MS=900000
LLM_MAX_CONCURRENCY=2
# Protsessiülene libiseva akna eelarve loendab teenusepakkuja mudelipäringuid ja
# tegelikke teenusepakkuja sisend- ja väljundtokeneid; SDK dispatch'i järel teadmata kasutus debiteerib täisreservi.
# Ammendumisel jääb allikapõhine deterministlik vastus alles.
LLM_BUDGET_WINDOW_MS=3600000
LLM_ROLLING_REQUEST_BUDGET=60
LLM_ROLLING_TOKEN_BUDGET=240000
LLM_CLIENT_REQUEST_BUDGET=15
LLM_CLIENT_TOKEN_BUDGET=120000
LLM_CLIENT_BUDGET_KEYS=2000
