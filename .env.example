# Rakenduse port konteineris
PORT=3000

# Terrapointi avaliku API alus-URL
TERRAPOINT_API_URL=https://terrapoint.ee

# Avalik HTTPS-aadress; proxyst tulnud HTTP päringud suunatakse siia
PUBLIC_ORIGIN=https://praktika.arleserver.cfd

# Eraldatud praktika andmebaas otsingu vahemälu ja päringute päritolu jaoks
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://practice_user:change-me@postgres:5432/keskkonnaportaal_practice
DATABASE_SSL=false
SEARCH_CACHE_ENABLED=true

# Qdranti eraldi kollektsioon hübriidseks järjestuseks
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=keskkonnaportaali_praktika_sources

# Serveripoolne, ainult allikatele toetuv LLM; jäta võti tühjaks deterministliku fallback'i jaoks
OPENCODE_ZEN_API_KEY=
LLM_BASE_URL=https://opencode.ai/zen/v1
LLM_MODEL=deepseek-v4-flash-free
LLM_ENABLED=true
