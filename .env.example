# Rakenduse port konteineris
PORT=3000

# Terrapointi avaliku API alus-URL ainult vanade proxy-route'ide tagasiühilduvuseks.
# Üldotsing Terrapointi ei kasuta.
TERRAPOINT_API_URL=https://terrapoint.ee

# Avalik HTTPS-aadress; proxyst tulnud HTTP päringud suunatakse siia
PUBLIC_ORIGIN=https://praktika.arleserver.cfd

# Eraldatud praktika andmebaas otsingu vahemälu ja päringute päritolu jaoks
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://practice_user:change-me@postgres:5432/keskkonnaportaal_practice
DATABASE_SSL=false
SEARCH_CACHE_ENABLED=true
SEARCH_DEADLINE_MS=15000

# Serveripoolne, ainult valitud tõenditele toetuv valikuline sõnastuskiht.
# Jäta võti tühjaks: läbi vaadatud vertikaalvastused ning aus abstention töötavad iseseisvalt.
OPENCODE_GO_API_KEY=
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-v4-flash
LLM_FALLBACK_MODEL=mimo-v2.5
LLM_ENABLED=true
LLM_TIMEOUT_MS=14500
LLM_MAX_TOKENS=1000
LLM_REASONING_EFFORT=low
LLM_CIRCUIT_BREAK_MS=900000
